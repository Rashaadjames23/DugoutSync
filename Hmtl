<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BaseSync - Baseball Practice Segment Clock</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        baseball: {
                            50: '#fdf8f6',
                            100: '#fbe8e4',
                            500: '#d9534f',
                            600: '#c9302c',
                            700: '#ac2925',
                            850: '#1b2430',
                            900: '#0f172a',
                            950: '#090d16'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter & Chivo -->
    <link href="https://fonts.googleapis.com/css2?family=Chivo:wght@700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-sport { font-family: 'Chivo', sans-serif; }
        .timer-glow { text-shadow: 0 0 25px rgba(217, 83, 79, 0.4); }
    </style>
</head>
<body class="bg-baseball-950 text-gray-100 min-h-screen flex flex-col selection:bg-baseball-500 selection:text-white">

    <!-- Toast Notification Banner -->
    <div id="toast" class="fixed top-5 right-5 z-50 transform translate-x-full transition-transform duration-300 bg-emerald-600 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 border border-emerald-500">
        <i class="fa-solid fa-circle-check text-xl"></i>
        <div>
            <h4 class="font-bold text-sm" id="toast-title">Success</h4>
            <p class="text-xs text-emerald-100" id="toast-msg">Action completed successfully.</p>
        </div>
    </div>

    <!-- Header Navigation -->
    <header class="bg-baseball-900 border-b border-gray-800 sticky top-0 z-40 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-baseball-500 text-white p-2.5 rounded-xl shadow-lg flex items-center justify-center">
                    <i class="fa-solid fa-baseball text-2xl animate-spin-slow"></i>
                </div>
                <div>
                    <h1 class="font-sport text-2xl tracking-wider text-white uppercase flex items-center gap-2">
                        BaseSync <span class="text-xs bg-baseball-500/20 text-baseball-500 border border-baseball-500/30 px-2 py-0.5 rounded-full font-normal">Pro Coach</span>
                    </h1>
                    <p class="text-xs text-gray-400">Live Synchronized Practice Segment Clock</p>
                </div>
            </div>

            <!-- Navigation Tabs & Coach Selector -->
            <div class="flex items-center space-x-2 sm:space-x-4">
                <!-- Coach Selector Dropdown -->
                <div class="relative">
                    <select id="active-coach-select" onchange="switchCoach(this.value)" class="bg-baseball-850 border border-gray-700 text-sm rounded-xl px-3 py-2 text-white font-medium focus:outline-none focus:border-baseball-500 transition cursor-pointer">
                        <option value="" disabled>Select Your Name:</option>
                        <option value="Nolan">Nolan</option>
                        <option value="Ryan">Ryan</option>
                        <option value="Rashaad">Rashaad</option>
                        <option value="Collin">Collin</option>
                        <option value="Christian">Christian</option>
                        <option value="Chris">Chris</option>
                        <option value="Jaxon">Jaxon</option>
                    </select>
                </div>

                <!-- Tab Buttons -->
                <nav class="flex space-x-1 bg-baseball-850 p-1.5 rounded-xl border border-gray-800">
                    <button onclick="switchTab('field')" id="tab-btn-field" class="px-3 sm:px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 bg-baseball-500 text-white shadow">
                        <i class="fa-solid fa-stopwatch"></i> <span class="hidden md:inline">Field View</span>
                    </button>
                    <button onclick="handleCreatorTabClick()" id="tab-btn-creator" class="px-3 sm:px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center gap-2 text-gray-400 hover:text-white cursor-pointer">
                        <i class="fa-solid fa-lock" id="creator-lock-icon"></i> <span class="hidden md:inline">Creator</span>
                    </button>
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ================= FIELD VIEW TAB ================= -->
        <div id="tab-field" class="space-y-6">
            
            <!-- Top Control Banner & Master Timer -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                
                <!-- Master Segment Timer Card -->
                <div class="lg:col-span-7 bg-gradient-to-br from-baseball-900 to-baseball-850 border border-gray-800 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden flex flex-col justify-between">
                    <div class="absolute -right-10 -bottom-10 opacity-5 pointer-events-none">
                        <i class="fa-solid fa-baseball text-9xl"></i>
                    </div>

                    <!-- Current Drill Header -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-gray-800">
                        <div>
                            <span class="text-xs font-bold tracking-widest text-baseball-500 uppercase bg-baseball-500/10 px-3 py-1 rounded-full border border-baseball-500/20" id="current-drill-index-badge">Drill 1 of 5</span>
                            <h2 class="font-sport text-2xl sm:text-3xl text-white mt-2" id="current-drill-title">Infield Ground Balls & Double Plays</h2>
                        </div>
                        <div class="text-right flex sm:flex-col items-center sm:items-end justify-between">
                            <span class="text-xs text-gray-400">Scheduled Time</span>
                            <span class="text-lg font-bold text-gray-200" id="current-drill-duration">10:00</span>
                        </div>
                    </div>

                    <!-- Timer Countdown Display -->
                    <div class="py-8 text-center my-auto">
                        <div class="font-sport text-6xl sm:text-8xl tracking-wider text-white timer-glow font-black" id="timer-display">
                            10:00
                        </div>
                        <p class="text-sm text-gray-400 mt-2 flex items-center justify-center gap-2">
                            <span id="timer-status-indicator" class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span id="timer-status-text">Ready to Start Practice</span>
                        </p>
                    </div>

                    <!-- Timer Control Bar -->
                    <div class="flex flex-wrap items-center justify-center gap-3 pt-4 border-t border-gray-800">
                        <button onclick="toggleTimer()" id="btn-toggle-timer" class="flex-1 min-w-[120px] bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition flex items-center justify-center gap-2 text-base">
                            <i class="fa-solid fa-play" id="play-pause-icon"></i> <span id="play-pause-text">Start Drill</span>
                        </button>
                        <button onclick="resetTimer()" class="bg-gray-800 hover:bg-gray-700 text-gray-300 font-semibold py-3 px-5 rounded-xl transition flex items-center gap-2" title="Reset Current Drill Timer">
                            <i class="fa-solid fa-rotate-right"></i> <span class="hidden sm:inline">Reset</span>
                        </button>
                        <button onclick="prevDrill()" class="bg-gray-800 hover:bg-gray-700 text-gray-300 font-semibold py-3 px-5 rounded-xl transition flex items-center gap-2" title="Previous Drill">
                            <i class="fa-solid fa-backward-step"></i> <span class="hidden sm:inline">Prev</span>
                        </button>
                        <button onclick="nextDrill()" class="bg-baseball-500 hover:bg-baseball-600 text-white font-semibold py-3 px-5 rounded-xl shadow-lg transition flex items-center gap-2" title="Next Drill">
                            <span class="hidden sm:inline">Next</span> <i class="fa-solid fa-forward-step"></i>
                        </button>
                    </div>
                </div>

                <!-- My Personal Coach Card (Highlighted for logged-in coach) -->
